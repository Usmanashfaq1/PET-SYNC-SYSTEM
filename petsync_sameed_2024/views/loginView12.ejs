<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>Login</title>
  <link href="https://fonts.googleapis.com/css?family=Karla:400,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.materialdesignicons.com/4.8.95/css/materialdesignicons.min.css">
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css">
  <link rel="stylesheet" href="../20F-0115_NODE_MVC_STRUCTURE_SETUP/public/static/assets/css/login.component.css">
  <link rel="stylesheet" href="../public/static/assets/css/style.css">
</head>
<body>

  
<section class="gradient-custom" style="height: 750px;">
  <div class="container py-5 h-100">
    <div class="row h-100">
      <!-- Right side: Content (e.g., Facebook-like content) -->
      <div class="col-lg-6 d-flex justify-content-center align-items-center">
        <div class="text-center">
          <h2>Welcome to PetSync Community!</h2>
          <p>Connect and share with other pet lovers in your life.</p>
          <!-- Add more content as needed -->
        </div>
      </div>
      
      <!-- Left side: Form -->
      <div class="col-lg-6">
        <div class="card shadow-2-strong" style="border-radius: 1rem;">
          <div class="card-body p-5 text-center">
            <form action="\login" method="POST" style="height: 490px;">
              <div class="mb-md-5 mt-md-4 pb-5">
                <div class="form-outline form-white mb-4">
                  <label for="username">Username</label>
                  <input type="text" id="typeEmailX" class="form-control form-control-lg" name="userName" id="username" required />
                </div>
                <div class="form-outline form-white mb-4">
                  <label for="password">Password</label>
                  <input type="password" name="passWord" id="password" class="form-control" placeholder="***********" required />
                </div>
                <button class="btn btn-outline-dark btn-lg px-5 custom-width-btn" type="submit">Login</button>
                <hr class="mx-n3">
                <a class="btn btn-outline-dark btn-lg px-5 custom-width-btn" href="/signup" style="background-color: #42B72A; margin-top: 10px;">Create New Account</a>
                <br>
                <br>
              </div>
            </form>
            
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
</body>
</html>
