          <div class="card card-primary card-outline">
            <div class="card-header">
              <h3 class="card-title">
                <i class="fas fa-edit"></i>
                PetCommunity Guidelines
              </h3>
            </div>
            <div class="card-body">
              <h4>Quick Guide</h4>
              <div class="row">
                <div class="col-5 col-sm-3">
                  <div class="nav flex-column nav-tabs h-100" id="vert-tabs-tab" role="tablist" aria-orientation="vertical">
                    <a class="nav-link active" id="vert-tabs-home-tab" data-toggle="pill" href="#vert-tabs-home" role="tab" aria-controls="vert-tabs-home" aria-selected="true">Profile</a>
                    <a class="nav-link" id="vert-tabs-profile-tab" data-toggle="pill" href="#vert-tabs-profile" role="tab" aria-controls="vert-tabs-profile" aria-selected="false">Create</a>
                    <a class="nav-link" id="vert-tabs-messages-tab" data-toggle="pill" href="#vert-tabs-messages" role="tab" aria-controls="vert-tabs-messages" aria-selected="false">Direct Messages</a>
                    <a class="nav-link" id="vert-tabs-explore-tab" data-toggle="pill" href="#vert-tabs-explore" role="tab" aria-controls="vert-tabs-explore" aria-selected="false">Explore</a>
                    <a class="nav-link" id="vert-tabs-find-people-tab" data-toggle="pill" href="#vert-tabs-find-people" role="tab" aria-controls="vert-tabs-find-people" aria-selected="false">Find People</a>
                    <a class="nav-link" id="vert-tabs-newsfeed-tab" data-toggle="pill" href="#vert-tabs-newsfeed" role="tab" aria-controls="vert-tabs-newsfeed" aria-selected="false">Newsfeed</a>
                    <a class="nav-link" id="vert-tabs-settings-tab" data-toggle="pill" href="#vert-tabs-settings" role="tab" aria-controls="vert-tabs-settings" aria-selected="false">Setting</a>
                  </div>
                </div>
                <div class="col-7 col-sm-9">
                  <div class="tab-content" id="vert-tabs-tabContent">
                    <!-- Profile Content -->
                    <div class="tab-pane text-left fade show active" id="vert-tabs-home" role="tabpanel" aria-labelledby="vert-tabs-home-tab">
                      <p>PetCommunity Profile Guidelines</p>
                      <ul>
                        <li>Fill out all required fields.</li>
                        <li>Use a clear and appropriate profile picture.</li>
                        <li>Provide accurate information about yourself.</li>
                      </ul>
                    </div>
                    <!-- Create Content -->
                    <div class="tab-pane fade" id="vert-tabs-profile" role="tabpanel" aria-labelledby="vert-tabs-profile-tab">
                      <p>PetCommunity Create Guidelines</p>
                      <ul>
                        <li>Only post content that is relevant to pets and the community.</li>
                        <li>Respect copyright laws and give credit when necessary.</li>
                        <li>Avoid sharing sensitive or inappropriate content.</li>
                      </ul>
                    </div>
                    <!-- Direct Messages Content -->
                    <div class="tab-pane fade" id="vert-tabs-messages" role="tabpanel" aria-labelledby="vert-tabs-messages-tab">
                      <p>PetCommunity Direct Messages Guidelines</p>
                      <ul>
                        <li>Use direct messages for private conversations only.</li>
                        <li>Respect the privacy and boundaries of other users.</li>
                        <li>Avoid sending spam or unsolicited messages.</li>
                      </ul>
                    </div>
                    <!-- Explore Content -->
                    <div class="tab-pane fade" id="vert-tabs-explore" role="tabpanel" aria-labelledby="vert-tabs-explore-tab">
                      <p>PetCommunity Explore Guidelines</p>
                      <ul>
                        <li>Explore different topics related to pets and the community.</li>
                        <li>Engage with other users' content by liking and commenting.</li>
                        <li>Discover new pet-related events, organizations, and resources.</li>
                      </ul>
                    </div>
                    <!-- Find People Content -->
                    <div class="tab-pane fade" id="vert-tabs-find-people" role="tabpanel" aria-labelledby="vert-tabs-find-people-tab">
                      <p>PetCommunity Find People Guidelines</p>
                      <ul>
                        <li>Connect with other users who share your interests.</li>
                        <li>Search for users based on their profiles and activities.</li>
                        <li>Follow or send friend requests to connect with others.</li>
                      </ul>
                    </div>
                    <!-- Newsfeed Content -->
                    <div class="tab-pane fade" id="vert-tabs-newsfeed" role="tabpanel" aria-labelledby="vert-tabs-newsfeed-tab">
                      <p>PetCommunity Newsfeed Guidelines</p>
                      <ul>
                        <li>Stay updated on the latest posts and activities from your connections.</li>
                        <li>Engage with posts by liking, commenting, or sharing.</li>
                        <li>Customize your newsfeed preferences to see the content you're interested in.</li>
                      </ul>
                    </div>
                    <!-- Settings Content -->
                    <div class="tab-pane fade" id="vert-tabs-settings" role="tabpanel" aria-labelledby="vert-tabs-settings-tab">
                      <p>PetCommunity Settings Guidelines</p>
                      <ul>
                        <li>Manage your account settings, privacy, and security.</li>
                        <li>Update your profile information and notification preferences.</li>
                        <li>Review and adjust your connected apps and integrations.</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- /.card-body -->
          </div>
          <!-- /.card -->
          
