  <script>
      function getParameterByName(name, url) {
          if (!url) url = window.location.href;
          name = name.replace(/[\[\]]/g, "\\$&");
          var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
              results = regex.exec(url);
          if (!results) return null;
          if (!results[2]) return '';
          return decodeURIComponent(results[2].replace(/\+/g, " "));
      }

      $(document).ready(function () {
          const id = getParameterByName('id');
          localStorage.setItem('edit', id);
          $.ajax({
              url: 'http://localhost:3001/open_profile/' + id,
              method: 'GET',
              success: function (data) {
                  data.forEach(function (result) {
                    localStorage.setItem('petname', result.petname);
                    localStorage.setItem('petid', result.id);
                      $('#petname').text( 'Pet Name : '+ result.petname || 'Default Petname');
                      $('#gender').text( 'Gender : '+result.gender || 'Default Gender');
                      $('#age').text( 'Age : ' + result.age + ' years'|| 'Default Age');
                      $('#breed').text('Breed : ' + result.breed || 'Default Breed');
                      $('#species').text( 'Specie : '+ result.species || 'Default Species');
                      $('#weight').text('weight : ' + result.weight + ' pounds'|| 'Default Weight');
                      $('#color').text('color : ' + result.color || 'Default Color');
                      $('#about').text('About : ' + result.about || 'Default About');
                      document.getElementById('img').src = `data:image/jpeg;base64,${result.petPicture}`;
                  });

                  // here doing ajax call to backend api to show number of posts of that specfic pet
                  const petname1=localStorage.getItem('petname');
                 const username1= localStorage.getItem('name');
                 
  // Fetch the count of posts for the specific pet
  $.ajax({
    
    url: `/api/pet-memories-count/${username1}/${petname1}`, // Update with your actual API endpoint
    type: 'GET',
    dataType: 'json',
    success: function (data) {
      // Update the post count in the div
      $('#postCount').html(`
        <p class="mb-1 h5">${data.count}</p>
        <p class="small text-muted mb-0">Posts</p>
      `);
    },
    error: function (error) {
      console.error('Error fetching post count:', error);
      // Handle the error accordingly
    }
  });
