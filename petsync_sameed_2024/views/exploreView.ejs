      display: flex;
      align-items: center;
      padding: 10px;
    }
    
    .profile-pic {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      margin-right: 10px;
    }
    
    .post-info {
      flex-grow: 1;
    }
    
    .post-content {
      padding: 10px;
    }
    
    .post-image {
      width: 100%;
      height: auto;
      margin-bottom: 10px;
    }
    
    .post-stats ul {
      list-style: none;
