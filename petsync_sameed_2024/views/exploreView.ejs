.facebook-post {
    background-color: #fff;
    border: 1px solid #eaeaea;
    border-radius: 5px;
    padding: 20px;
}

.facebook-post .post-header {
    display: flex;
    align-items: center;
    margin-bottom: 15px;
}

.facebook-post .profile-pic {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    margin-right: 10px;
}

.facebook-post .post-info {
    flex-grow: 1;
}

.facebook-post .post-author {
    margin: 0;
    font-size: 18px;
}

.facebook-post .post-time {
    margin: 0;
    color: #999;
    font-size: 14px;
}

.facebook-post .post-content {
    margin-bottom: 15px;
}

.facebook-post .post-image {
    width: 100%;
    height: auto;
    border-radius: 5px;
    margin-bottom: 10px;
}

.facebook-post .post-caption {
    margin-bottom: 10px;
}

.facebook-post .post-caption h5 {
    margin: 0;
    font-size: 16px;
}

.facebook-post .post-stats {
    display: flex;
    align-items: center;
    font-size: 14px;
}

.facebook-post .post-stats ul {
    list-style: none;
    margin: 0;
    padding: 0;
}

.facebook-post .post-stats ul li {
    margin-right: 20px;
}

.facebook-post .post-stats ul li:last-child {
    margin-right: 0;
}

    
