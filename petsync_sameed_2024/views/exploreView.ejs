    /* profile */
    
    .container123 {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    
    .card1 {
      flex: 1;
      aspect-ratio: 1 / 1; /* Set aspect ratio to 1:1 for square images */
      border: 1px solid #ccc;
      border-radius: 8px;
      overflow: hidden;
    }
    
    .card-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
     
    
    .gallery123 {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      grid-gap: 20px;
    }
    
    
    .enlarged-image {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: contain; /* Ensure the image fits within the viewport */
      background-color: rgba(0, 0, 0, 0.8); /* Semi-transparent background */
      z-index: 1000; /* Ensure the enlarged image is above other content */
      cursor: pointer; /* Show pointer cursor when hovering over the image */
    }
    
    
    
    
    
    
