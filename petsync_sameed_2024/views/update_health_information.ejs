  <script>
    // Your existing scripts remain unchanged

    function getParameterByName(name, url) {
      if (!url) url = window.location.href;
      name = name.replace(/[\[\]]/g, "\\$&");
      var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
        results = regex.exec(url);
      if (!results) return null;
      if (!results[2]) return '';
      return decodeURIComponent(results[2].replace(/\+/g, " "));
    }


    // AJAX for recording health information
    $(document).ready(function () {
      // Your code here
      const idd = getParameterByName('idd');
      $.ajax({
        url: `/get_records_for_update/${idd}`,
        type: 'GET',
        contentType: 'application/json',
        success: function (response) {
          response.forEach(function (result) {
            $('#medication').val(result.medication);
            $('#allergies').val(result.allergies);
            $('#vaccination').val(result.vaccination);
            $('#surgeries').val(result.surgeries);
          });
        },
        error: function (error) {
          console.error('Error recording health information:', error);
          alert('Error recording health information. Please try again.');
        }
      });
    });


    $('#updateRecord').submit(function (event) {
      event.preventDefault();

      const idd = getParameterByName('idd');
      const formData = $(this).serializeArray();
      const healthInfo = {};

      formData.forEach((field) => {
        healthInfo[field.name] = field.value;
      });

      $.ajax({
        url: `/update_health_record/${idd}`,
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(healthInfo),
        success: function (response) {
          window.location.reload();
          window.location.href = '/view-health-information';
        },
        error: function (error) {
          console.error('Error recording health information:', error);
          alert('Error recording health information. Please try again.');
        }
      });
    });
  </script>

