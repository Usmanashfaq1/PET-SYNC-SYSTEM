    <script>


      $(document).ready(function () {
        $('#petProfileForm').submit(function (e) {
          e.preventDefault();
  
          register_profile();
  
        });
  
      });
  
  
      function register_profile() {
        const username = localStorage.getItem('name');
        const petname1 = localStorage.getItem('petname');
        var about = $("#about").val();
        var petPicture = document.getElementById('petPicture').files[0];
        if (!petPicture || !about) {
          document.getElementById('message').innerText = 'Select Both picture and about to post';
          showDialog();
          return;
        }
        var formData = new FormData();
        formData.append('username', username);
        formData.append('petname', petname1);
        formData.append('about', about);
        formData.append('petPicture', petPicture);
        $.ajax({
          url: 'http://localhost:3001/create_pet_profile_post',
          type: 'POST',
          data: formData,
          contentType: false,
          processData: false,
          success: function (response) {
            if (response === 1) {
              document.getElementById('message').innerText = 'Post created Successfully';
              showDialog();
            } else {
              document.getElementById('message').innerText = 'Post creation failed';
              showDialog();
            }
          },
          error: function () {
            alert('Post creation failed. Error at localhost:3001');
          }
        });
      }
    </script>
