<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Behavior Record</title>
    <!-- Bootstrap CSS -->
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="container mt-5">
        <h2>Edit Behavior Record</h2>
        <form action="/update_behavior" method="POST">
            <input type="hidden" name="petId" value="<%= record.pet_id %>">
            <div class="form-group">
                <label for="dateTime">Date & Time:</label>
                <input type="datetime-local" class="form-control" id="dateTime" name="dateTime" value="<%= record.date_time %>">
            </div>
            <div class="form-group">
                <label for="description">Description:</label>
                <textarea class="form-control" id="description" name="description" rows="3"><%= record.description %></textarea>
            </div>
            <div class="form-group">
                <label for="category">Category:</label>
                <select class="form-control" name="category" id="category">
                    <option value="<%= record.category %>"><%= record.category %></option>
                    <option value="Behavior">Behavior</option>
                    <option value="Training">Training</option>
                    <option value="Milestone">Milestone</option>
                    <!-- Add more options as needed -->
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Update</button>
            <a href="/feedrbt_view" class="btn btn-secondary">Cancel</a>
        </form>
        <!-- Delete button -->
        <form action="/delete_behavior" method="POST" class="mt-3">
            <input type="hidden" name="petId" value="<%= record.pet_id %>">
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
    </div>
    <!-- Bootstrap JS -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>

</html>
