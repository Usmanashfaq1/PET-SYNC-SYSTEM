<script>
    const form = document.getElementById('feedingScheduleForm');

    form.addEventListener('submit', function(event) {
        event.preventDefault();
        
        const petId = document.getElementById('petSelect').value;
        const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
        const scheduleData = [];

        days.forEach(function(day) {
            const mealName = document.querySelector(`input[name=${day.toLowerCase()}Meal]`).value;
            const portionSize = document.querySelector(`input[name=${day.toLowerCase()}Portion]`).value;
            
            if (mealName && portionSize) {
                scheduleData.push({
                    day_of_week: day,
                    meal_name: mealName,
                    portion_size: portionSize,
                    pet_id: petId
                });
            }
        });

        // Sending the schedule data to the server
        fetch('/save-schedule', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(scheduleData)
        })
        .then(response => {
            if (response.ok) {
                alert('Feeding schedule saved successfully!');
                form.reset();
            } else {
                throw new Error('Failed to save feeding schedule.');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to save feeding schedule. Please try again.');
        });
    });
</script>
