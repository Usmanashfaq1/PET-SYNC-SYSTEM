    <div class="container" style=" padding-left: 320px;">
      <h2>Post Timeline</h2>
      <div class="gallery">
        <!-- here added the check if no post is psoted or user dont have any post show this.... -->
        
        <div id="load-feed-new" style="display: flex; flex-wrap: wrap; justify-content: center;">
            <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css" rel="stylesheet">
            <% for (var i = 0; i < userData.feedResult.length; i++) { %>
                <div class="container bootstrap snippets bootdey" style="margin: 10px;">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <div class="user-block" style="display: flex; align-items: center;">
                                    <img class="img-circle" src="/profilepics/<%=profilePic%>" alt="User Image" width="40" height="40"></img>
                                    <!-- ADD PROFILE PIC OF USER WHO POSTED IT -->
                                    <span class="username" style="margin-left: 10px;"><a href="/account/<%=userData.feedResult[i].username%>"><%=userData.feedResult[i].username%></a></span>
                                    <span class="description" style="margin-left: auto;"><%= moment(userData.feedResult[i].created_at).fromNow() %></span>
                                    <!-- IN ABOVE LINE, ADD HREF TO USER'S ACCOUNT -->
                                </div>
                            </div>
                            <div class="card-body">
                                <img class="img-responsive pad" id="<%=userData.feedResult[i].feedname%>" onclick="showFeed(this.id);return false;" src="/profilepics/<%=userData.feedResult[i].feedname%>" alt="Photo" style="width: 100%; height: auto;">
                                <!-- INSERT SRC -->
                            </div>
                            <div class="card-footer">
                                <div class="btn btn-default btn-sm" style="position: relative;">
                                    <% if (userData.feedResult[i].isliked === 'dislike') { %>
                                    <i class="fa fa-heart fa-2x" id="like-icon-<%=userData.feedResult[i].feedname%>" style="color: red;"></i>
                                    <% } else { %>
                                    <i class="fa fa-heart-o fa-2x" id="like-icon-<%=userData.feedResult[i].feedname%>" style="color: black;"></i>
                                    <% } %>
                                    <input type="button" style="border: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0;" id="like-btn-<%=userData.feedResult[i].feedname%>" onclick="likeImage('<%=userData.feedResult[i].feedname%>', this)" value="<%=userData.feedResult[i].isliked%>" />
                                    <!-- Hiding the text inside the button -->
                                </div>
                               
                                <span class="pull-right text-muted">
                                    <i class="fa fa-heart" style="color: red;"></i> <%=userData.feedResult[i].likes %> likes 
                                    <i class="fa fa-comment" style="color: red;"></i> <%=userData.feedResult[i].comment_count %> comments

                                    <button class="btn btn-link btn-comment" style="color: black;" onmouseover="this.style.color='blue'" onmouseout="this.style.color='black'" id="<%=userData.feedResult[i].feedname%>" onclick="showFeed(this.id);return false;"  >Add Comment</button>
                                </span>
                                
                                
                                <!-- ADD LIKE, COMMENT COUNT -->
                            </div>
                            <p class="card-text caption" style="margin: 10px; padding-left: 8px;"><%= userData.feedResult[i].caption %></p>
                        </div>
                    </div>
                </div>
                <% } %>
        </div>
  
    
