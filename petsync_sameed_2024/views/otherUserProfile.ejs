      <!-- Main content -->
      <section class="content">
        <div class="container-fluid">
          <div class="row">
            <div class="col-md-3">
  
              <!-- Profile Image -->
              <div class="card card-primary card-outline">
                <div class="card-body box-profile">
                  <div class="text-center">
                    <img  class="profile-user-img img-fluid img-circle" style="width: 120px;height: 135px;"
                     src="/profilepics/<%=userData.dpName%>"
                         alt="User profile picture">
                  </div>
  
                  <h3 class="profile-username text-center"><%= userData.data.username %></h3>
  
                  <p class="text-muted text-center">Software Engineer</p>
                 
  
                  <ul class="list-group list-group-unbordered mb-3">
                    <li class="list-group-item">
                      <b>Followers</b> <a class="float-right"><%= followResult ? followResult.followers : 0 %></a>
                    </li>
                    <li class="list-group-item">
                      <b>Following</b> <a class="float-right"><%= followResult ? followResult.following : 0 %></a>
                    </li>
                  </ul>
                  
                  <input type="button" id="follow-btn" class="btn btn-primary btn-block" value="<%=initialFollowedUnfollowed%>" name="followUser">
                
                  <br>
                  <a href="/direct-message/<%= userData.data.username %>">
                    <button class="btn btn-primary btn-block">Send Message</button>
                </a>
                <br>
                  <!-- User Profile View -->
<div class="user-profile">
    
    <!-- Profile information goes here -->
    <button class="btn btn-primary report-user-btn" onclick="openReportModal()">Report User</button>
</div>
<div id="reportUserModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeReportModal()">&times;</span>
        <form id="reportUserForm">  <!-- <form id="reportUserForm" action="/report/user/<%= userData.data.id %>" method="POST"> -->

            <div class="form-group">
                <label for="reportReason">Reason for Reporting:</label>
                <textarea class="form-control" id="reportReason" name="reason" rows="3" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Submit Report</button>
                    <!-- Dialog Box -->
<div class="overlay" id="overlay" style="display: none;">
    <div class="dialog-box">
        <p id="message"></p>
       
    </div>
</div>
        </form>
    </div>
</div>
                </div>
                <!-- /.card-body -->
              </div>
              <!-- /.card -->
  
              <!-- About Me Box -->
              <div class="card card-primary">
                <div class="card-header">
                  <h3 class="card-title">About Me</h3>
                </div>
                <!-- /.card-header -->
                <div class="card-body">
                  <strong><i class="fas fa-book mr-1"></i> Bio</strong>
  
                  <p class="text-muted">
                    <%=userData.data.bio%>
                  </p>
  
                  <hr>
  
                  <strong><i class="fas fa-map-marker-alt mr-1"></i> Location</strong>
  
                  <p class="text-muted"><%= userData.data.location %></p>
  
                  <hr>
  
                  <strong><i class="fas fa-pencil-alt mr-1"></i> Skills</strong>
  
                  <p class="text-muted">
                    <span class="tag tag-danger">UI Design</span>
                    <span class="tag tag-success">Coding</span>
                    <span class="tag tag-info">Javascript</span>
                    <span class="tag tag-warning">PHP</span>
                    <span class="tag tag-primary">Node.js</span>
                  </p>
  
                  <hr>
  
                  <strong><i class="far fa-file-alt mr-1"></i> BirthDate</strong>
  
                  <p class="text-muted"><%= userData.data.birthdate%></p>
  
                  <strong><i class="far fa-file-alt mr-1"></i> Notes</strong>
  
                  <p class="text-muted"><%=userData.data.note%></p>
  
  
                </div>
                <!-- /.card-body -->
              </div>
              <!-- /.card -->
            </div>
            <!-- /.col -->
            <div class="col-md-9">
              <div class="card">
                <div class="card-header p-2">
                  <ul class="nav nav-pills">
                    
                    <li class="nav-item"><a class="nav-link active" href="#activity" data-toggle="tab">Pets</a></li>
                    
                    <li class="nav-item"><a class="nav-link" href="#post" data-toggle="tab">Photos</a></li>
                  </ul>
                </div><!-- /.card-header -->
                <div class="card-body">
                  <div class="tab-content">
                    
                    <!-- /.tab-pane -->
                   
  
                    <div class="active tab-pane" id="activity">
                        <!-- Post -->
                        <% results.forEach(pet => { %>
                          <!-- Post -->
                          <div class="card mb-4">
                              <!-- Pet Picture -->
                              <div class="card-body text-center">
                                <img class="img-thumbnail" src="/upload1/<%= pet.petPicture %>" alt="Pet Picture" style="width: 150px; height: 150px; object-fit: cover;">
                            </div>
                              <!-- /.card-body -->
                              
                              <!-- Pet Details -->
                              <div class="card-footer">
                                  <h4 class="text-center"><%= pet.petname %></h4>
                                  <ul class="list-unstyled">
                                      <li><strong>Species:</strong> <%= pet.species %></li>
                                      <li><strong>Age:</strong> <%= pet.age %> years</li>
                                      <li><strong>Weight:</strong> <%= pet.weight %> lbs</li>
                                      <!-- Add more pet details here as needed -->
                                  </ul>
                              </div>
                              <!-- /.card-footer -->
                          </div>
                          <!-- /.card -->
                      <% }); %>
                      
                          
                        <!-- /.post -->
                      </div>
  
                    <div class="tab-pane" id="post">
                      <!-- post views -->
                      <div class="container123">
                        <div class="gallery123">
