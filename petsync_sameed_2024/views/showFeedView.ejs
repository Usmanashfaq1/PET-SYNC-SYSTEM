    <main class="fix">
        <section>
            
            <div class="container">
                <div class="row">
                    <div class="col-md-8 mx-auto">
                        <div class="card">
                            <div class="card-header d-flex align-items-center">
                                <img class="img-circle" src="/profilepics/<%=profilePic%>" alt="User Image" width="40" height="40">

                                <div class="ml-3">
                                    <a href="/account/<%=likeUserCreatedATCount.username%>"><%=likeUserCreatedATCount.username%></a>
                                    <span class="text-muted">Shared  - <%=moment(likeUserCreatedATCount.created_at).fromNow()%></span>
                                </div>
                                <div class="ml-auto">
                                    <button type="button" href="#" class="close-link"><i  class="fa fa-times"></i></button>
                                </div>
                            </div>
                            <div class="card-body">
                                <img class="img-fluid" src="/profilepics/<%=postId%>" alt="Photo">
                                <div class="mt-3 d-flex align-items-center">
                                    <div class="mr-3">
                                        <button class="btn btn-link btn-lg">
                                            <i class="fa fa-heart fa-2x text-danger"><%=likeUserCreatedATCount.likes%>  likes</i> <!-- Red heart icon for likes -->
                                        </button>
                                    </div>
                                    <button class="btn btn-link btn-lg">
                                        <i class="fa fa-comments fa-2x text-info"><%=comments.length%>  comments</i> <!-- Chosen icon for comments -->
                                        
                                    </button>
                                </div>
                                <hr>
                                <div class="comments">
                                    <% for (let i=0; i < comments.length; i++) { %>
                                    <div class="comment mb-3">
                                       
                                        <div class="ml-3">
                                            <a class="text-primary" href="/account/<%= comments[i].commentby %>" style="font-size: 14px; font-weight: bold;"><%= comments[i].commentby %></a>

                                            <span class="text-muted ml-2"><%= moment(comments[i].created_at).fromNow() %></span>
                                            <p class="mt-1"><%= comments[i].commenttext %></p>
                                        </div>
                                    </div>
                                    <% } %>
                                </div>
                            </div>
                            <!-- here posting comment api from comment controller -->
                            <div class="card-footer">
                                <form id="postCommentForm" action="/profile/postFeed/<%=postId%>/comment" method="POST">
                                    <div class="input-group">
                                        <input class="form-control" type="text" autocomplete="off" name="commentText" placeholder="Add a comment..." required>
                                        <div class="input-group-append">
                                            <button type="submit" class="btn btn-primary">Post</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        </section>

       






