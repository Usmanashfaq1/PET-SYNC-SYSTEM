  <script>
    $(document).ready(function () {
      const username = localStorage.getItem('name');
      $.ajax({
        url: 'http://localhost:3001/get_profiles/' + username,
        method: 'GET',
        success: function (data) {
          // Clear existing table rows
          $('#Data_table').empty();
          if (data && data.length > 0) {
            data.forEach(function (result) {

              var row = $('<tr>');
              row.html(`
  <td>${result.pet_owner}</td>
  <td>${result.petname}</td>
  <td>${result.gender}</td>
  <td>${result.age}</td>
  <td>${result.breed}</td>
  <td>${result.species}</td>
  <td>${result.weight}</td>
  <td>${result.color}</td>
  <td>${result.about}</td>
  <td><img src="data:image/jpeg;base64,${result.petPicture}" alt="Pet Picture" style="width: 4rem; height: 4rem;"></td>
  <td><button class="btn btn-success" onclick="openProfile(${result.id})">Open</button></td>
`);



              $('#Data_table').append(row);
            });
          } else {
            // Pet details not found
            $('#Data_table').append('<tr><td colspan="6">No pet profile details found</td></tr>');
          }
        },
        error: function (error) {
          console.error('Error fetching pet details:', error);
          alert('Error fetching pet profile at backend. Please try again.');
          $('#Data_table').empty();
        }
      });
    });


  </script>
