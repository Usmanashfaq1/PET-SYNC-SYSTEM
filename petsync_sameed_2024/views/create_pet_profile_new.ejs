  <script>


    $(document).ready(function () {
      $('#petProfileForm').submit(function (e) {
        e.preventDefault();
        if ($("#dobOrAge").val() < 1 || $("#dobOrAge").val() > 30) {
          document.getElementById('message').innerText = 'Choose age between 1 to 30 years';
          showDialog();
        }
        else if ($("#weight").val() < 1 || $("#weight").val() > 50) {
          document.getElementById('message').innerText = 'Choose weight between 1 to 50 Kgs';
          showDialog();
        }
        else {
          check_user();
        }
      });

    });


    function check_user() {
      var petname = $("#petname").val();
      var data = { petname: petname };
      let post = JSON.stringify(data);
      $.ajax({
        url: 'http://localhost:3001/check_petname',
        headers: {
          'Content-Type': 'application/json'
        },
        type: 'POST',
        contentType: 'application/json',
        data: post,
        success: function (data) {
          if (data == 1) {

            document.getElementById('message').innerText = 'Pet name already taken!';
            showDialog();
          }
          else {

            register_profile();

          }

        },
        error: function () {
          alert('error');
        }
      });
    }


    function register_profile() {
      const username = localStorage.getItem('name');
      var petname = $("#petname").val();
      var gender = $("#gender").val();
      var age = $("#dobOrAge").val();
      var breed = $("#breed").val();
      var weight = $("#weight").val();
      var species = $("#species").val();
      var color = $("#color").val();
      var about = $("#about").val();
      var petPicture = document.getElementById('petPicture').files[0];
      if (!petPicture) {
        alert("select picture for profile");
        return;
      }
      var formData = new FormData();
      formData.append('username', username);
      formData.append('petname', petname);
      formData.append('gender', gender);
      formData.append('age', age);
      formData.append('breed', breed);
      formData.append('species', species);
      formData.append('weight', weight);
      formData.append('color', color);
      formData.append('about', about);

      formData.append('petPicture', petPicture);
      $.ajax({
        url: 'http://localhost:3001/create_pet_profile',
        type: 'POST',
        data: formData,
        contentType: false,
        processData: false,
        success: function (response) {
          if (response === 1) {
            window.location.reload();
            window.location.href = '/pet-profile';
          } else {
            document.getElementById('message').innerText = 'Profile creation failed';
            showDialog();
          }
        },
        error: function () {
          alert('Profile creation failed. Error at localhost:3001');
        }
      });
    }
  </script>
