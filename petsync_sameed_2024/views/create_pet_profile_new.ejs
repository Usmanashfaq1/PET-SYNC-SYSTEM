</head>

<body>

  <style>
    .overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }

    /* Styles for the dialog box */
    .dialog-box {
      background: #fff;
      padding: 20px;
      border-radius: 5px;
      max-width: 400px;
      text-align: center;
    }

    /* Close button style */
    .close-btn {
      background: #007BFF;
      color: #fff;
      border: none;
      padding: 10px 20px;
      cursor: pointer;
      border-radius: 5px;
    }




    @media (min-width: 1025px) {
      .vh-100 {
        height: 100vh !important;
        overflow-y: auto;
        /* Add this line to enable vertical scrollbar */
      }
    }


    .is-invalid {
      border-color: #dc3545;
      background-color: #f8d7da;
    }

    /* You can add more styles for the error message if needed */
    .error-message {
      color: #ffffff;
      margin-top: 2px;
    }
  </style>

  <section class="vh-100" style="background-color: #eee;">
    <div class="container h-100">
      <div class="row d-flex justify-content-center align-items-center h-100">
        <div class="col-lg-12 col-xl-11">
          <div class="card text-black" style="border-radius: 25px;">
            <div class="card-body p-md-5">
              <div class="row justify-content-center">
                <div class="col-md-10 col-lg-6 col-xl-5 order-2 order-lg-1">
                  <p class="text-center h1 fw-bold mb-5 mx-1 mx-md-4 mt-4">Pet Profile</p>

                  <form id="petProfileForm">

                    <div class="d-flex flex-row align-items-center mb-4">
                      <i class="fas fa-user fa-lg me-3 fa-fw"></i>
                      <div class="form-outline flex-fill mb-0">
                        <label for="petName">Pet's Name:</label>
                        <input type="text" id="petname" name="petname" class="form-control" required>
                      </div>
                    </div>

                    <div class="d-flex flex-row align-items-center mb-4">
                      <i class="fas fa-paw fa-lg me-3 fa-fw"></i>
                      <div class="form-outline flex-fill mb-0">
                        <label for="species">Species:</label>
                        <select id="species" name="species" class="form-control" required>
                          <option value="dog">Dog</option>
                          <option value="cat">Cat</option>
                          <option value="bird">Bird</option>
                          <!-- Add more options as needed -->
                        </select>
                      </div>
                    </div>

                    <div class="d-flex flex-row align-items-center mb-4">
                      <i class="fas fa-bone fa-lg me-3 fa-fw"></i>
                      <div class="form-outline flex-fill mb-0">
                        <label for="petBreed">Breed</label>
                        <select id="breed" name="breed" class="form-select" required>
                          <option value="" disabled selected>Select a Breed</option>

                          <!-- Top 10 Cat Breeds -->
                          <optgroup label="Top 10 Cat Breeds">
                            <option value="persian">Persian</option>
                            <option value="maineCoon">Maine Coon</option>
                            <option value="siamese">Siamese</option>
                            <option value="ragdoll">Ragdoll</option>
                            <option value="bengal">Bengal</option>
                            <option value="abyssinian">Abyssinian</option>
                            <option value="sphynx">Sphynx</option>
                            <option value="britishShorthair">British Shorthair</option>
                            <option value="scottishFold">Scottish Fold</option>
                            <option value="burmese">Burmese</option>
                          </optgroup>

                          <!-- Top 10 Dog Breeds -->
                          <optgroup label="Top 10 Dog Breeds">
                            <option value="labrador">Labrador Retriever</option>
                            <option value="germanShepherd">German Shepherd</option>
                            <option value="goldenRetriever">Golden Retriever</option>
                            <option value="bulldog">Bulldog</option>
                            <option value="beagle">Beagle</option>
                            <option value="poodle">Poodle</option>
                            <option value="boxer">Boxer</option>
                            <option value="dachshund">Dachshund</option>
                            <option value="siberianHusky">Siberian Husky</option>
                            <option value="chihuahua">Chihuahua</option>
                          </optgroup>

                          <!-- Top 10 Bird Breeds -->
                          <optgroup label="Top 10 Bird Breeds">
                            <option value="budgerigar">Budgerigar</option>
                            <option value="cockatiel">Cockatiel</option>
                            <option value="lovebird">Lovebird</option>
                            <option value="canary">Canary</option>
                            <option value="parakeet">Parakeet</option>
                            <option value="finch">Finch</option>
                            <option value="africanGreyParrot">African Grey Parrot</option>
                            <option value="amazonParrot">Amazon Parrot</option>
                            <option value="cockatoo">Cockatoo</option>
                            <option value="macaw">Macaw</option>
                          </optgroup>
                        </select>
                      </div>
                    </div>




                    <div class="d-flex flex-row align-items-center mb-4">
                      <i class="fas fa-paint-brush fa-lg me-3 fa-fw"></i>
                      <div class="form-outline flex-fill mb-0">
                        <label for="color">Color:</label>
                        <input type="text" id="color" name="color" class="form-control">
                      </div>
                    </div>

                    <div class="d-flex flex-row align-items-center mb-4">
                      <i class="fas fa-calendar fa-lg me-3 fa-fw"></i>
                      <div class="form-outline flex-fill mb-0">
                        <label for="dobOrAge">Age:</label>
                        <input type="number" id="dobOrAge" name="dobOrAge" class="form-control">
                      </div>
                    </div>

                    <div class="d-flex flex-row align-items-center mb-4">
                      <i class="fas fa-venus-mars fa-lg me-3 fa-fw"></i>
                      <div class="form-outline flex-fill mb-0">
                        <label for="gender">Gender:</label>
                        <select id="gender" name="gender" class="form-control" required>
                          <option value="male">Male</option>
                          <option value="female">Female</option>
                          <option value="other">Other</option>
                        </select>
                      </div>
                    </div>

                    <div class="d-flex flex-row align-items-center mb-4">
                      <i class="fas fa-weight fa-lg me-3 fa-fw"></i>
                      <div class="form-outline flex-fill mb-0">
                        <label for="weight">Weight (in kg):</label>
                        <input type="number" id="weight" name="weight" class="form-control">
                      </div>
                    </div>

                    <div class="d-flex flex-row align-items-center mb-4">
                      <i class="fas fa-info fa-lg me-3 fa-fw"></i>
                      <div class="form-outline flex-fill mb-0">
                        <label for="about">About:</label>
                        <input type="text" id="about" name="about" class="form-control">
                      </div>
                    </div>

                    <div class="mb-4">
                      <label for="petPicture" class="form-label">Pet Picture:</label>
                      <input type="file" name="petPicture" id="petPicture" class="form-control" accept="image/*">
                    </div>

                    <!-- Include additional fields as needed -->

                    <div class="form-check d-flex justify-content-center mb-5">
                      <input class="form-check-input me-2" type="checkbox" value="" id="form2Example3c" required>
                      <label class="form-check-label" for="form2Example3">
                        I agree to all statements in <a href="#!">Terms of service</a>
                      </label>
                    </div>

                    <div class="d-flex justify-content-center mx-4 mb-3 mb-lg-4">
                      <button type="submit" class="btn btn-primary btn-lg">Save Pet Profile</button>
                    </div>

                  </form>
                  <div class="overlay" id="overlay">
                    <div class="dialog-box">
                      <p id='message'></p>
                      <button class="close-btn" onclick="closeDialog()">Close</button>
                    </div>
                  </div>
                </div>
                <div class="col-md-10 col-lg-6 col-xl-7 d-flex align-items-center order-1 order-lg-2">
                  <img src="../public/assets_E/img/pet_profile.jpg" class="img-fluid" alt="Sample image">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>



  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.0/js/bootstrap.bundle.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

  <script>


    $(document).ready(function () {
      $('#petProfileForm').submit(function (e) {
        e.preventDefault();
        if ($("#dobOrAge").val() < 1 || $("#dobOrAge").val() > 30) {
          document.getElementById('message').innerText = 'Choose age between 1 to 30 years';
          showDialog();
        }
        else if ($("#weight").val() < 1 || $("#weight").val() > 50) {
          document.getElementById('message').innerText = 'Choose weight between 1 to 50 Kgs';
          showDialog();
        }
        else {
          check_user();
        }
      });

    });


    function check_user() {
      var petname = $("#petname").val();
      var data = { petname: petname };
      let post = JSON.stringify(data);
      $.ajax({
        url: 'http://localhost:3001/check_petname',
        headers: {
          'Content-Type': 'application/json'
        },
        type: 'POST',
        contentType: 'application/json',
        data: post,
        success: function (data) {
          if (data == 1) {

            document.getElementById('message').innerText = 'Pet name already taken!';
            showDialog();
          }
          else {
            
            register_profile();

          }

        },
        error: function () {
          alert('error');
        }
      });
    }


    function register_profile() {
      const username = localStorage.getItem('name');
      var petname = $("#petname").val();
      var gender = $("#gender").val();
      var age = $("#dobOrAge").val();
      var breed = $("#breed").val();
      var weight = $("#weight").val();
      var species = $("#species").val();
      var color = $("#color").val();
      var about = $("#about").val();
      var petPicture = document.getElementById('petPicture').files[0];
      if (!petPicture) {
        alert("select picture for profile");
        return;
      }
      var formData = new FormData();
      formData.append('username', username);
      formData.append('petname', petname);
      formData.append('gender', gender);
      formData.append('age', age);
      formData.append('breed', breed);
      formData.append('species', species);
      formData.append('weight', weight);
      formData.append('color', color);
      formData.append('about', about);

      formData.append('petPicture', petPicture);
      $.ajax({
        url: 'http://localhost:3001/create_pet_profile',
        type: 'POST',
        data: formData,
        contentType: false,
        processData: false,
        success: function (response) {
          if (response === 1) {
            window.location.reload();
            window.location.href = '/pet-profile';
          } else {
            document.getElementById('message').innerText = 'Profile creation failed';
            showDialog();
          }
        },
        error: function () {
          alert('Profile creation failed. Error at localhost:3001');
        }
      });
    }
  </script>
  <script>


    function showDialog() {
      // if ((loginStatus === "idle") || (loginStatus === "finished"))
      document.getElementById('overlay').style.display = 'flex';
      // console.log('here');
    }

    function closeDialog() {
      document.getElementById('overlay').style.display = 'none';
    }


  </script>
</body>

</html>