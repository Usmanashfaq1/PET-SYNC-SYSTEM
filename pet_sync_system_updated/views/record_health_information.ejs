<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Your existing head content remains unchanged -->
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>Record Health Information</title>
  <meta content="" name="description">
  <meta content="" name="keywords">

  <!-- Favicons -->
  <link href="favicon.png" rel="icon">
  <link href="apple-touch-icon.png" rel="apple-touch-icon">
  <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet">

  <!-- Bootstrap CSS -->
  <link href="assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">

  <!-- Your existing style and script links remain unchanged -->

  <style>
    body {
      background-color: #f8f9fa;
    }

    .gradient-custom {
      /* fallback for old browsers */
      background: #f093fb;

      /* Chrome 10-25, Safari 5.1-6 */
      background: -webkit-linear-gradient(to bottom right, rgba(240, 147, 251, 1), rgba(245, 87, 108, 1));

      /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
      background: linear-gradient(to bottom right, rgba(240, 147, 251, 1), rgba(245, 87, 108, 1));
    }

    .card-registration .select-input.form-control[readonly]:not([disabled]) {
      font-size: 1rem;
      line-height: 2.15;
      padding-left: .75em;
      padding-right: .75em;
    }

    .card-registration .select-arrow {
      top: 13px;
    }

    .container-center {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100vh;
    }

    .form-container {
      background-color: #ffffff;
      padding: 20px;
      border-radius: 15px;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.2);
    }

    .timeline {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .timeline-item {
      padding: 20px;
      background-color: #ffffff;
      margin-bottom: 20px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
  </style>
</head>

<body>
  <section class="vh-100 gradient-custom">
    <div class="container py-5 h-100">
      <div class="row justify-content-center align-items-center h-100">
        <div class="col-12 col-lg-9 col-xl-7">
          <div class="card shadow-2-strong card-registration form-container">
            <div class="card-body p-4 p-md-5">
              <form id="recordHealthInfoForm">
                <h3 class="mb-4 text-center">Record Health Information</h3>

                <!-- Add dropdowns for vaccination, medication, allergies, surgeries -->
                <div class="mb-3">
                  <label for="vaccination" class="form-label">Vaccination:</label>
                  <select class="form-select" id="vaccination" name="vaccination" required>
                    <option value="" disabled selected>Select Vaccination</option>
                    <option value="rabies">Rabies</option>
                    <option value="distemper">Distemper</option>
                    <option value="parvovirus">Parvovirus</option>
                    <option value="adenovirus">Adenovirus</option>
                    <option value="leptospirosis">Leptospirosis</option>
                    <option value="bordetella">Bordetella (Kennel Cough)</option>
                    <option value="feline-leukemia">Feline Leukemia</option>
                    <option value="feline-rhinotracheitis">Feline Rhinotracheitis</option>
                    <option value="canine-coronavirus">Canine Coronavirus</option>
                    <option value="canine-influenza">Canine Influenza</option>
                    <option value="no vaccination">No Vaccination</option>
                  </select>

                </div>
                <div class="mb-3">
                  <label for="medication" class="form-label">Medication:</label>
                  <select class="form-select" id="medication" name="medication" required>
                    <option value="" disabled selected>Select Medication</option>
                    <option value="antibiotic">Antibiotic</option>
                    <option value="pain-reliever">Pain Reliever</option>
                    <option value="anti-inflammatory">Anti-Inflammatory</option>
                    <option value="antifungal">Antifungal</option>
                    <option value="heartworm-preventive">Heartworm Preventive</option>
                    <option value="flea-and-tick-control">Flea and Tick Control</option>
                    <option value="allergy-medication">Allergy Medication</option>
                    <option value="dewormer">Dewormer</option>
                    <option value="joint-supplement">Joint Supplement</option>
                    <option value="No Medication">No Medication</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label for="allergies" class="form-label">Allergies:</label>
                  <select class="form-select" id="allergies" name="allergies" required>
                    <option value="" disabled selected>Select Allergies</option>
                    <option value="Flea Saliva And Bites">Flea Saliva And Bites</option>
                    <option value="Environmental Allergens">Environmental Allergens</option>
                    <option value="Food Allergens">Food Allergens </option>
                    <option value="Insect Bites And Stings">Insect Bites And Stings</option>
                    <option value="Plants And Allergies In Dogs">Plants And Allergies In Dogs</option>
                    <option value="Medications">Medications </option>
                    <option value="Contact Allergens">Contact Allergens</option>
                    <option value="Smoke And Pollution">Smoke And Pollution</option>
                    <option value="No Allergies">No Allergies</option>


                    <!-- Add more options as needed -->
                  </select>
                </div>
                <div class="mb-3">
                  <label for="surgeries" class="form-label">Surgeries:</label>
                  <select class="form-select" id="surgeries" name="surgeries" required>
                    <option value="" disabled selected>Select Surgeries</option>
                    <option value="spaying-neutering">Spaying/Neutering</option>
                    <option value="dental-cleaning">Dental Cleaning</option>
                    <option value="tumor-removal">Tumor Removal</option>
                    <option value="orthopedic-surgery">Orthopedic Surgery</option>
                    <option value="soft-tissue-surgery">Soft Tissue Surgery</option>
                    <option value="eye-surgery">Eye Surgery</option>
                    <option value="abdominal-surgery">Abdominal Surgery</option>
                    <option value="fracture-repair">Fracture Repair</option>
                    <option value="c-section">C-Section</option>
                    <option value="joint-surgery">Joint Surgery</option>
                    <option value="no_surgery">No Surgery</option>
                  </select>

                </div>

                <button style="align-self: center;" type="submit" class="btn btn-primary btn-block">Record Health
                  Information</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bootstrap and other script links remain unchanged -->
  <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Your existing scripts remain unchanged

    // AJAX for recording health information
    $('#recordHealthInfoForm').submit(function (event) {
      event.preventDefault();

      const petId = localStorage.getItem('petid');
      const formData = $(this).serializeArray();
      const healthInfo = {};

      formData.forEach((field) => {
        healthInfo[field.name] = field.value;
      });

      $.ajax({
        url: `/api/record-health-information/${petId}`,
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(healthInfo),
        success: function (response) {
          window.location.reload();
          window.location.href = '/view-health-information';
        },
        error: function (error) {
          console.error('Error recording health information:', error);
          alert('Error recording health information. Please try again.');
        }
      });
    });
  </script>
</body>

</html>