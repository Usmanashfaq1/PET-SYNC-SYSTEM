      <script>
        $(document).ready(function () {

          
          // Handle vet type selection change event
          $('#party').change(function () {
            var selectedVetType = $(this).val();
            if (selectedVetType) {
              // Fetch vet details based on selected vet type
              $.ajax({
                url: 'http://localhost:4000/api/vets?type=' + selectedVetType,
                method: 'GET',
                success: function (data) {
                  // Clear existing table rows
                  $('#party-details-body').empty();
                  // Append vet details to table
                  if (data && data.length > 0) {
                    data.forEach(function (record) {
                      var row = $('<tr>');
                      row.html(`
                    <td>${record.fname}</td>
                    <td>${record.lname}</td>
                    <td>${record.specialization}</td>
                    <td>${record.qualification}</td>
                    <td>${record.location}</td>
                    <td>${record.timeslot}</td>

                    <td><button class="btn btn-primary" onclick="bookAppointment('${record.fname}', '${record.lname}', '${record.specialization}', '${record.qualification}' , '${record.email}')">Book</button></td>
                  `);
                      $('#party-details-body').append(row);
                    });
                  } else {
                    // Vet details not found
                    $('#party-details-body').append('<tr><td colspan="5">No vet details found</td></tr>');
                  }
                },
                error: function (error) {
                  console.error('Error fetching vet details:', error);
                  alert('Error fetching vet details. Please try again.');
                  $('#party-details-body').empty();
                }
              });
            } else {
              // No vet type selected
              $('#party-details-body').empty();
            }
          });
        });





        function bookAppointment(fname, lname, specialization, qualification, email) {
          // Retrieve vet information dynamically
          //book appointment
          const vetName = `${fname} ${lname}`;
          const vetEmail = `${email}`;

          // Validate input fields (user information)
          // here updated current session user name and email is used while making appointmenet to vet
          const storedName1 = localStorage.getItem('name');
          const email1 = localStorage.getItem('email');// 
          const userName = storedName1;
          var slot = $("#preferredDateTime").val();
          var subject = $("#appointmentReason").val();
          const userEmail = email1;
          var slot12 = new Date($("#preferredDateTime").val());

          var currentDate = new Date();
          // date checking here 
if (slot12 < currentDate) {
  showMessage('Do not go in history!', 'warning');
return;
}

          if (!slot || !subject) {
            alert("Please Fill in the required Fields!");
  return;
}
else{

            

          // Prepare data for the AJAX request
          const appointmentData = {
            user_name: userName,
            user_email: userEmail,
            vet_name: vetName,
            vet_email: vetEmail,
            type: `(${specialization})`,
            slot: slot,
            subject :subject
          };


          $.ajax({
            url: 'http://localhost:4000/api/appointments',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(appointmentData),
            success: function (response) {
              console.log('Appointment booked successfully:', response);
              //showMessage( `Appointment booked with ${fname} ${lname}, ${specialization}, ${qualification},${email}`, 'success');
              alert(`Appointment booked with ${fname} ${lname}, ${specialization}, ${qualification},${email}`);
              window.close("/appointment-scheduling");
              window.open("/user-dashboard");

            },
            error: function (error) {
              console.error('Error booking appointment:', error);
              alert('Error booking appointment. Please try again.');
            }
          });
        }

      }

      </script>
      <script>


        // made a new logic of back function to destroy current session of user and window and take back to front page without browser chache and back+forward buttons

        function back() {
          //ajax call to delete session here
          window.close("/appointment-scheduling");
          window.open("/front");
        }

        function showMessage(message, type) {
  const messageContainer = document.getElementById('message-container');

  // Create a Bootstrap Toast element
  const toast = document.createElement('div');
  toast.classList.add('toast', `bg-${type}`, 'text-white');
  toast.setAttribute('role', 'alert');
  toast.setAttribute('aria-live', 'assertive');
  toast.setAttribute('aria-atomic', 'true');

  // Set the message content
  toast.innerHTML = `
    <div class="toast-header">
      <strong class="mr-auto">Notification</strong>
      <button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <div class="toast-body">${message}</div>
  `;

  // Append the toast to the message container
  messageContainer.appendChild(toast);

  // Show the toast
  new bootstrap.Toast(toast).show();
}
