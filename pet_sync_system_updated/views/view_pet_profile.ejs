<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<style>
    * {
        margin: 0;
        padding: 0
    }

    body {
        background-color: #000
    }

    .card {
        width: 650px;
        background-color: #efefef;
        border: none;
        cursor: pointer;
        transition: all 0.5s;
    }

    .image img {
        transition: all 0.5s
    }

    .card:hover .image img {
        transform: scale(1.5)
    }

    .btn {
        height: 140px;
        width: 140px;
        border-radius: 50%
    }

    .name {
        font-size: 22px;
        font-weight: bold
    }

    .idd {
        font-size: 14px;
        font-weight: 600
    }

    .idd1 {
        font-size: 12px
    }

    .number {
        font-size: 22px;
        font-weight: bold
    }

    .follow {
        font-size: 12px;
        font-weight: 500;
        color: #444444
    }

    .btn1 {
        height: 40px;
        width: 150px;
        border: none;
        background-color: #000;
        color: #aeaeae;
        font-size: 15px
    }

    .text span {
        font-size: 13px;
        color: #545454;
        font-weight: 500
    }

    .icons i {
        font-size: 19px
    }

    hr .new1 {
        border: 1px solid
    }

    .join {
        font-size: 14px;
        color: #a0a0a0;
        font-weight: bold
    }

    .date {
        background-color: #ccc
    }
</style>

<body style="background: rgb(45, 255, 255);">
    <div class="container mt-4 mb-4 p-3 d-flex justify-content-center">
        <div class="card p-4">
            <div class="image d-flex flex-column justify-content-center align-items-center">
                <button class="btn btn-secondary">
                    <img id="img" height="100" width="100" />
                </button>
                <!-- <span class="name mt-3" id="pet_owner"></span> -->
                <span class="idd" id="petname"></span>
                <span class="idd" id="gender"></span>
                <span class="idd" id="age"></span>
                <span class="idd" id="breed"></span>
                <span class="idd" id="Species"></span>
                <span class="idd" id="weight"></span>
                <span class="idd" id="color"></span>
                <span class="idd" id="about"></span>
                <div class="d-flex flex-row justify-content-center align-items-center gap-2">
                    <span class="idd1" id="extra_id">Oxc4c16a645_b21a</span>
                    <span><i class="fa fa-copy"></i></span>
                </div>
                <div class="d-flex flex-row justify-content-center align-items-center mt-3">
                    <span class="number" id="followers">1069
                        <span class="follow">Followers</span>
                    </span>
                </div>
                <div class="d-flex mt-2">
                    <button class="btn1 btn-dark">Edit Profile</button>
                </div>
                <div class="text mt-3" id="about"></div>
                <div class="gap-3 mt-3 icons d-flex flex-row justify-content-center align-items-center">
                    <span><i class="fa fa-twitter"></i></span>
                    <span><i class="fa fa-facebook-f"></i></span>
                    <span><i class="fa fa-instagram"></i></span>
                    <span><i class="fa fa-linkedin"></i></span>
                </div>
                <div class="px-2 rounded mt-4 date ">
                    <span class="join" id="joined">Joined May,2021</span>
                </div>
            </div>
        </div>
    </div>

    <script>

        function getParameterByName(name, url) {
            if (!url) url = window.location.href;
            name = name.replace(/[\[\]]/g, "\\$&");
            var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
                results = regex.exec(url);
            if (!results) return null;
            if (!results[2]) return '';
            return decodeURIComponent(results[2].replace(/\+/g, " "));
        }



        $(document).ready(function () {
            // Usage
            const id = getParameterByName('id');
            alert(id);
            $.ajax({
                url: 'http://localhost:4000/open_profile/' + id,
                method: 'GET',
                success: function (data) {
                    data.forEach(function (result) {
                        // Assuming 'result' is an object with properties like 'pet_owner', 'petname', etc.

                        // Set values for spans
                        $('#petname').text(result.petname || 'Default Petname');
                        $('#gender').text(result.gender || 'Default Gender');
                        $('#age').text(result.age || 'Default Age');
                        $('#breed').text(result.breed || 'Default Breed');
                        $('#species').text(result.species || 'Default Species');
                        $('#weight').text(result.weight || 'Default Weight');
                        $('#color').text(result.color || 'Default Color');
                        $('#about').text(result.about || 'Default About');

                        // Set the 'img' source
                        document.getElementById('img').src = `data:image/jpeg;base64,${result.petPicture}`;
                    });
                },
                error: function (error) {
                    console.error('Error fetching pet details:', error);
                    alert('Error fetching pet profile at backend. Please try again.');
                    $('#Data_table').empty();
                }
            });
        });
    </script>
</body>

</html>