<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>

<style>
  .btn-cute {
  font-family: 'Your Cute Font', sans-serif; /* Replace with a cute font */
  font-size: 16px; /* Adjust the font size */
  border-radius: 20px; /* Adjust the border-radius for rounded corners */
}

.btn-pink {
  background-color: #ff4081; /* Adjust the pink color */
}

.btn-purple {
  background-color: #9c27b0; /* Adjust the purple color */
}

.btn-yellow {
  background-color: #ffeb3b; /* Adjust the yellow color */
}

.btn-blue {
  background-color: #2196f3; /* Adjust the blue color */
}
    /* CSS for the Modal */
    .modal {
        display: none;
        position: fixed;
        z-index: 1;
        padding-top: 50px;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.9);
    }

    .modal-content {
        margin: auto;
        display: block;
        max-width: 80%;
        max-height: 80%;
    }

    .close {
        color: #fff;
        position: absolute;
        top: 15px;
        right: 35px;
        font-size: 30px;
        font-weight: bold;
        cursor: pointer;
    }

    .close:hover {
        color: #3498db;
    }


</style>

<body style="background-image: url('../assets/img/view.jpg');">

    <section class="h-100 gradient-custom-2">
        <div class="container py-5 h-100">
          <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col col-lg-9 col-xl-7">
              <div class="card">
                <div class="rounded-top text-white d-flex flex-row" style="background-color: #000; height:200px;">
                  <div class="ms-4 mt-5 d-flex flex-column" style="width: 150px;">
                    <img id = "img"
                      alt="Generic placeholder image" class="img-fluid img-thumbnail mt-4 mb-2"
                      style="width: 150px; z-index: 1">
                      <div style="display: flex; justify-content: space-between;">
                        <button type="button" onclick="redirectToEditProfile()" class="btn btn-primary" data-mdb-ripple-color="dark" style="margin: 20px; z-index: 1;">
                            Edit profile
                        </button>
                        <button type="button" class="btn btn-primary" data-mdb-ripple-color="dark" style="margin: 20px; z-index: 1;">
                            Home
                        </button>
                    </div>
                    
                  </div>
                  <div class="ms-3" style="margin-top: 130px;">
                    <h5 id = "petname"></h5>
                    <p id = "species"></p>
                  </div>
                </div>
                <div class="p-4 text-black" style="background-color: #f8f9fa;">
                  <div class="d-flex justify-content-end text-center py-1">
                    
                    <div id="postCount">
                      <p class="mb-1 h5">Loading...</p>
                      <p class="small text-muted mb-0">Posts</p>
                    </div>
                  </div>
                </div>
                <div class="card-body p-4 text-black">
                    <div class="mb-5">
                      <p class="lead fw-normal mb-1">About</p>
                      <div class="p-4" style="background-color: #f8f9fa;">
                        <p class="font-italic mb-1" id = "age"></p>
                        
                        <p class="font-italic mb-0" id = "weight"></p>

                        <p class="font-italic mb-1" id = "breed"></p>

                        <p class="font-italic mb-1" id = "color"></p>

                        <p class="font-italic mb-1"  id = "about"></p>
                      </div>
                    </div>
                    <div class="card-body p-4 text-black">
                      <div class="d-flex flex-column align-items-center mb-4">
                        <a href="/record-health-information" class="btn btn-cute btn-pink mb-2 text-white">Record Health Information</a>
                        <a href="/view-health-information" class="btn btn-cute btn-purple mb-2 text-white">View Health Records</a>
                        <a href="/create-post" class="btn btn-cute btn-yellow mb-2 text-white">Create Post</a>
                        <a href="/pet-memories-timeline" class="btn btn-cute btn-blue mb-2 text-white">View PET-MEMORIES</a>
                      </div>
                    </div>
              </div>
            </div>
          </div>
        </div>
      </section>

    

    <script>
        // Add a click event listener to the image
        document.getElementById('img').addEventListener('click', function () {
            openModal();
        });

        // Function to open the modal
        function openModal() {
            document.getElementById('imageModal').style.display = 'block';
            // Set the modal image source to the clicked image source
            document.getElementById('modalImage').src = document.getElementById('img').src;
        }

        // Function to close the modal
        function closeModal() {
            document.getElementById('imageModal').style.display = 'none';
        }
    </script>

    <script>
        function getParameterByName(name, url) {
            if (!url) url = window.location.href;
            name = name.replace(/[\[\]]/g, "\\$&");
            var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
                results = regex.exec(url);
            if (!results) return null;
            if (!results[2]) return '';
            return decodeURIComponent(results[2].replace(/\+/g, " "));
        }

        $(document).ready(function () {
            const id = getParameterByName('id');
            localStorage.setItem('edit', id);
            $.ajax({
                url: 'http://localhost:4000/open_profile/' + id,
                method: 'GET',
                success: function (data) {
                    data.forEach(function (result) {
                      localStorage.setItem('petname', result.petname);
                      localStorage.setItem('petid', result.id);
                        $('#petname').text(result.petname || 'Default Petname');
                        $('#gender').text(result.gender || 'Default Gender');
                        $('#age').text( 'Age : '+result.age + ' years'|| 'Default Age');
                        $('#breed').text('Breed : ' + result.breed || 'Default Breed');
                        $('#species').text(result.species || 'Default Species');
                        $('#weight').text('weight : ' + result.weight + ' pounds'|| 'Default Weight');
                        $('#color').text('color : ' + result.color || 'Default Color');
                        $('#about').text(result.about || 'Default About');
                        document.getElementById('img').src = `data:image/jpeg;base64,${result.petPicture}`;
                    });

                    // here doing ajax call to backend api to show number of posts of that specfic pet
                    const petname1=localStorage.getItem('petname');
                   const username1= localStorage.getItem('name');
                   
    // Fetch the count of posts for the specific pet
    $.ajax({
      
      url: `/api/pet-memories-count/${username1}/${petname1}`, // Update with your actual API endpoint
      type: 'GET',
      dataType: 'json',
      success: function (data) {
        // Update the post count in the div
        $('#postCount').html(`
          <p class="mb-1 h5">${data.count}</p>
          <p class="small text-muted mb-0">Posts</p>
        `);
      },
      error: function (error) {
        console.error('Error fetching post count:', error);
        // Handle the error accordingly
      }
    });
                },
                error: function (error) {
                    console.error('Error fetching pet details:', error);
                    alert('Error fetching pet profile at backend. Please try again.');
                }
            });
        });
    </script>
               
       
    </script>


<script>
    function redirectToEditProfile() {
        // Redirect to the edit-profile page
        window.location.href = '/edit-profile';
    }
</script>

</body>

</html>
