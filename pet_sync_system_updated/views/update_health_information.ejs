<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Your existing head content remains unchanged -->
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>Pet Care System</title>
  <meta content="" name="description">
  <meta content="" name="keywords">

  <!-- Favicons -->
  <link href="favicon.png" rel="icon">
  <link href="apple-touch-icon.png" rel="apple-touch-icon">
  <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet">

  <!-- Bootstrap CSS -->
  <link href="assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">

  <!-- Your existing style and script links remain unchanged -->

  <style>
    /* Your additional styles remain unchanged */
  </style>
</head>

<body>
  <!-- Your existing body content remains unchanged -->

  <div class="container py-5">
    <div class="row">
      

      <div class="col-lg-6">
        <!-- Update Health Information Form -->
        <form id="updateHealthInfoForm">
          <h2 class="mb-4">Update Health Information</h2>

          <!-- Add input fields for record ID, vaccination, medication, allergies, surgeries -->
          <div class="mb-3">
            <label for="recordId" class="form-label">Record ID:</label>
            <input type="text" class="form-control" id="recordId" name="recordId" required>
          </div>

        

          <button type="submit" class="btn btn-primary">Update Health Information</button>
        </form>
      </div>
    </div>
  </div>
  </div>

  <!-- Bootstrap and other script links remain unchanged -->
  <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    
    // Your existing scripts remain unchanged

   
    // AJAX for updating health information
    $('#updateHealthInfoForm').submit(function (event) {
      event.preventDefault();

      const recordId = $('#recordId').val();
      const formData = $(this).serializeArray();
      const healthInfo = {};

      formData.forEach((field) => {
        healthInfo[field.name] = field.value;
      });

      $.ajax({
        url: `/api/update-health-information/${recordId}`,
        type: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify(healthInfo),
        success: function (response) {
          alert(response.message);
        },
        error: function (error) {
          console.error('Error updating health information:', error);
          alert('Error updating health information. Please try again.');
        }
      });
    });
  </script>
</body>

</html>
