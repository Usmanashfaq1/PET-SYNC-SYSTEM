<!-- views/petProfile.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pet Profile</title>

  <style>
    body {
      font-family: 'Arial', sans-serif;
      background-color: #f4f4f4;
      margin: 0;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100vh;
    }

    form {
      background-color: #ffffff;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      width: 400px;
      max-width: 100%;
      box-sizing: border-box;
    }

    h1 {
      text-align: center;
      color: #333333;
    }

    label {
      display: block;
      margin-bottom: 8px;
      color: #555555;
    }

    input,
    textarea {
      width: 100%;
      padding: 8px;
      margin-bottom: 16px;
      box-sizing: border-box;
      border: 1px solid #cccccc;
      border-radius: 4px;
    }

    input[type="radio"] {
      margin-right: 8px;
    }

    button {
      background-color: #4caf50;
      color: #ffffff;
      padding: 10px 20px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 16px;
    }

    button:hover {
      background-color: #45a049;
    }
  </style>
</head>
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

<body
  style="background-image: url('../assets/img/pet_profile_bg.png'); background-size: cover; background-repeat: no-repeat; background-position: center center;">
  <div>
    <form id="profile" role="form" style="background-color: rgb(255, 122, 73);">
      <h1>Pet Profile</h1>

      <!-- Gender -->
      <div>
        <label for="gender">Gender:</label>
        <label><input type="radio" name="gender" id="gender_male" value="male"> Male</label>
        <label><input type="radio" name="gender" id="gender_female" value="female"> Female</label>
        <label><input type="radio" name="gender" id="gender_other" value="other"> Other</label>
      </div>

      <!-- Age -->
      <div>
        <label for="age">Age:</label>
        <input type="number" name="age" id="age" required>
      </div>

      <!-- Breed -->
      <div>
        <label for="breed">Breed:</label>
        <input type="text" name="breed" id="breed" required>
      </div>

      <!-- Additional Information -->
      <div>
        <label for="additionalInfo">Additional Information / About:</label>
        <textarea name="additionalInfo" id="about" rows="4" cols="50"></textarea>
      </div>
      <!-- Picture -->
      <div>
        <label for="petPicture">Pet Picture:</label>
        <input type="file" name="petPicture" id="petPicture" accept="image/*">
      </div>

      <!-- Submit Button -->
      <div>
        <button type="submit">Submit</button>
      </div>
    </form>
  </div>
</body>

<script>
  $(document).ready(function () {
    $('#profile').submit(function (e) {
      e.preventDefault();
      register_profile();
    });


  });

  function register_profile() {
  const username = localStorage.getItem('name');
  var gender = $("input[name='gender']:checked").val();
  var age = $("#age").val();
  var breed = $("#breed").val();
  var about = $("#about").val();

  // Handle file upload
  var petPicture = document.getElementById('petPicture').files[0];

  if (gender == undefined || age == '' || breed == '' || !petPicture) {
    alert("Please fill in all the required fields");
    return;
  }

  var formData = new FormData();
  formData.append('username', username);
  formData.append('gender', gender);
  formData.append('age', age);
  formData.append('breed', breed);
  formData.append('about', about);
  formData.append('petPicture', petPicture);
  $.ajax({
    url: 'http://localhost:4000/create_pet_profile',
    type: 'POST',
    data: formData,
    contentType: false,
    processData: false,
    success: function (response) {
      if (response === 1) {
        alert("Profile created successfully");
        //window.location.reload();
      } else {
        alert("Profile creation failed");
      }
    },
    error: function () {
      alert('Profile creation failed. Error at localhost:4000');
    }
  });
}



</script>

</html>