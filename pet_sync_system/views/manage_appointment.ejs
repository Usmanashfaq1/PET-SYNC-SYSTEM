  <script>
    //here calling ajax call to fetch data from api into table accordingly
    $(document).ready(function () {
      // Handle vet type selection change event
     
          // Fetch vet details based on selected vet type
          $.ajax({
            url: 'http://localhost:4000/api/appointment',
            method: 'GET',
            success: function (data) {
              // Clear existing table rows
              $('#party-details-body').empty();
              // Append vet details to table
              if (data && data.length > 0) {
                data.forEach(function (record) {
                  var row = $('<tr>');
                  row.html(`
                    <td>${record.user_name}</td>
                    <td>${record.user_email}</td>
                    <td>${record.type}</td>
                    <td><button class="btn btn-primary" onclick="bookAppointment('${record.fname}', '${record.lname}', '${record.specialization}', '${record.qualification}' , '${record.email}')">Approve</button></td>
                  `);
                  $('#party-details-body').append(row);
                });
              } else {
                // Vet details not found
                $('#party-details-body').append('<tr><td colspan="5">No vet details found</td></tr>');
              }
            },
            error: function (error) {
              console.error('Error fetching vet details:', error);
              alert('Error fetching vet details. Please try again.');
              $('#party-details-body').empty();
            }
          });
    });

   

    
    
  function bookAppointment(fname, lname, specialization, qualification,email) {
    // Retrieve vet information dynamically
    const vetName = `${fname} ${lname}`;
    const vetEmail = `${email}`;  

    // Validate input fields (user information)
    const userName = $('#userName').val().trim();
    const userEmail = $('#userEmail').val().trim();
    if (!userName || !userEmail) {
      alert('Please enter both your name and email.');
      return;
    }

    // Prepare data for the AJAX request
    const appointmentData = {
      user_name: userName,
      user_email: userEmail,
      vet_name: vetName,
      vet_email: vetEmail,
      type: `(${specialization})`  
    };

   
    $.ajax({
      url: 'http://localhost:4000/api/appointments',
      method: 'POST',
      contentType: 'application/json',
      data: JSON.stringify(appointmentData),
      success: function (response) {
        console.log('Appointment booked successfully:', response);
        
        alert(`Appointment booked with ${fname} ${lname}, ${specialization}, ${qualification},${email}`);
        window.open("/user-dashboard");
        
      },
      error: function (error) {
        console.error('Error booking appointment:', error);
        alert('Error booking appointment. Please try again.');
      }
    });
  }


   
  </script>
