    <section class="content">
      <div class="container-fluid">
          <div class="row">
              <% for(var i=0; i < feedResult.length; i++) { %>
              <div class="col-sm-2 gallery-item">
                  <a href="profilepics/<%=feedResult[i].feedname%>" data-toggle="lightbox" data-title="Feed <%= i+1 %>" data-gallery="gallery">
                      <img src="profilepics/<%=feedResult[i].feedname%>" class="img-fluid mb-2" alt="Feed <%= i+1 %>"/>
                  </a>
                  <div id="<%=feedResult[i].feedname%>" onclick="showFeed(this.id);return false;" class="gallery-item-info">
                      <ul>
                          <!-- Add any additional information or buttons here -->
                      </ul>
                  </div>
              </div>
              <% } %>
          </div>
      </div><!-- /.container-fluid -->
  </section>
  
    
