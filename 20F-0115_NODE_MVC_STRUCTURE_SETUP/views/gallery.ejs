<style>
  .gallery-item {
    margin-bottom: 20px;
    position: relative;
}

.gallery-item:hover .gallery-item-info {
    opacity: 1;
    transition: opacity 0.3s ease-in-out;
}

.gallery-item-info {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    background-color: rgba(0, 0, 0, 0.7);
    color: #fff;
    padding: 5px 10px;
    border-radius: 5px;
    opacity: 0;
}

.gallery-item-info ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
}
</style>
