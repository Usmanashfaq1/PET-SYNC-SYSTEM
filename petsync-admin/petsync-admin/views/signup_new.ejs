                            <div class="col-md-6">
                                <h3 class="fw-normal mb-4" style="color: #4835d4;">General Information Veterinarian</h3>
                                <h3 class="fw-normal mb-4" style="color: #4835d4;">PETSYNC</h3>
                                <div class="mb-3">
                                    <label class="form-label" for="fname">First Name</label>
