  <main class="fix">

    <section class="breadcrumb__area fix">
      <div class="container">
        <div class="row align-items-end">
          <div class="col-lg-8">
            <div class="breadcrumb__content">
              <h3 class="title">Home</h3>
              <nav class="breadcrumb">
                <span property="itemListElement" typeof="ListItem">
                  <a>Home</a>
                </span>
                <span class="breadcrumb-separator"><i class="flaticon-right-arrow-angle"></i></span>
                <span property="itemListElement" typeof="ListItem">Users</span>
              </nav>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="breadcrumb__img">
              <img src="../public/assets/img/images/breadcrumb_img.png" alt="img" data-aos="fade-left"
                data-aos-delay="800">
            </div>
          </div>
        </div>
      </div>
      <div class="breadcrumb__shape-wrap">
        <img src="../public/assets/img/images/breadcrumb_shape01.png" alt="img" data-aos="fade-down-right"
          data-aos-delay="400">
        <img src="../public/assets/img/images/breadcrumb_shape02.png" alt="img" data-aos="fade-up-left"
          data-aos-delay="400">
      </div>
    </section>
    <section>
      <main role="main" class="col-md-9 ml-sm-auto col-lg-10 pt-3 px-4">
          
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
            <!-- Page header -->
            <h1 class="h2">Users</h1>

            <!-- Search form -->
            <form action="/users_media" method="GET" class="mb-3">
                <div class="input-group">
                    <input type="text" class="form-control" name="q" placeholder="Search users by name..." value="<%= searchQuery %>">
                    <div class="input-group-append">
                        <select class="form-control" name="sortByBlocked">
                            <option value="">Sort by Blocked</option>
                            <option value="blocked" <%= sortByBlocked === 'blocked' ? 'selected' : '' %>>Blocked</option>
                            <option value="notblocked" <%= sortByBlocked === 'notblocked' ? 'selected' : '' %>>Not Blocked</option>
                        </select>
                        <button type="submit" class="btn btn-primary">Search</button>
                    </div>
                </div>
            </form>
            
        </div>
        
        <div class="container">
            <div class="row">
                <% users.forEach(user => { %>
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">User ID: <%= user.id %></h5>
                            <p class="card-text">
                                <strong>Username:</strong> <%= user.username %><br>
                                <strong>Email:</strong> <%= user.email %><br>
                                <strong>Blocked:</strong> <%= user.is_blocked ? 'Yes' : 'No' %><br>
                            </p>
                            <form action="/block1/<%= user.id %>" method="POST">
                                <button type="submit" class="btn btn-danger">Block</button>
                            </form>
                            <br>
                            <form action="/unblock/<%= user.id %>" method="POST">
                                <button type="submit" class="btn btn-success">Unblock</button>
                            </form>
                            <br>
                            <form action="/delete/<%= user.id %>" method="POST">
                                <button type="submit" class="btn btn-warning">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
        

     

</div>

      
    </main>
    
    
  </div>
  
 

    </section>



    </div>




  </main>



  <footer class="main-footer">
    <!-- To the right -->
    <div class="float-right d-none d-sm-inline">
      
      <br>
    </div>
