                  </ul>
                </li>
                <li class="menu-item-has-child">
                  <a href="">Social Media Control</a>
                  <ul class="sub-menu">
                    <li><a href="/admin" style="color: rgb(0, 0, 0);">Report</a></li>
                    <li><a href="/users_media" style="color: rgb(0, 0, 0);">Users</a></li>
                    <li><a href="/requests" style="color: rgb(0, 0, 0);">Requests</a></li>
                  </ul>
                </li>
              </ul>


            </div>
          </div>
          <div class="col-xl-2 col-md-4">
            <div class="logo">
              <a><img src="../public/assets/img/logo/w_logo.png" alt="Logo"></a>
            </div>
          </div>
          <div class="col-xl-5 col-md-8">
            <div class="row align-items-center justify-content-end"> <!-- Modified -->
              <div class="col-md-auto"> <!-- Modified -->
                <div class="tgmenu__action tgmenu__action-three d-none d-md-block justify-content-end">
                  <ul class="list-wrap" style="margin: 0;">
                    <li class="header-login">
                      <a href=""><i class="flaticon-user" style="color: white;"></i></a>
                    </li>
                  </ul>
