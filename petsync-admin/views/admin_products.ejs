    <main class="fix">

      <section class="breadcrumb__area fix">
        <div class="container">
            <div class="row align-items-end">
                <div class="col-lg-8">
                    <div class="breadcrumb__content">
                        <h3 class="title">Add Product</h3>
                        <nav class="breadcrumb">
                            <span property="itemListElement" typeof="ListItem">
                                <a>Home</a>
                            </span>
                            <span class="breadcrumb-separator"><i class="flaticon-right-arrow-angle"></i></span>
                            <span property="itemListElement" typeof="ListItem">All Products</span>
                        </nav>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="breadcrumb__img">
                        <img src="../public/assets/img/images/breadcrumb_img.png" alt="img" data-aos="fade-left"
                            data-aos-delay="800">
                    </div>
                </div>
            </div>
        </div>
        <div class="breadcrumb__shape-wrap">
            <img src="../public/assets/img/images/breadcrumb_shape01.png" alt="img" data-aos="fade-down-right"
                data-aos-delay="400">
            <img src="../public/assets/img/images/breadcrumb_shape02.png" alt="img" data-aos="fade-up-left"
                data-aos-delay="400">
        </div>
    </section>


    <div class="carousel-item active">
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="card bg-light">
                        <div class="card-body p-0">
                            <div class="row g-0">
                                <div class="col-lg-6">
                                    <div class="p-5">      
                                        <div class="mb-4 pb-2">
                                            <label class="form-label fw-bold" for="pname">Product name</label>
                                            <div class="form-outline">
                                                <input type="text" id="pname" name="pname" class="form-control form-control-lg" required />
                                            </div>
                                        </div>
    
                                        <div class="mb-4 pb-2">
                                            <label class="form-label fw-bold" for="category">Category:</label>
                                            <select id="category" name="category" class="form-select form-select-lg" required>
                                                <option value="Pet">Pet</option>
                                                <option value="Pet Food">Pet Food</option>
                                                <option value="Pet Medicine">Pet Medicine</option>
                                            </select>
                                        </div>
    
                                        <div class="mb-4 pb-2">
                                            <label class="form-label fw-bold" for="price">Price</label>
                                            <div class="form-outline">
                                                <input type="number" id="price" name="price" class="form-control form-control-lg" required min="1" max="100">
                                            </div>
                                        </div>
    
                                        <div class="mb-4 pb-2">
                                            <label class="form-label fw-bold" for="stock">Quantity/Stock</label>
                                            <div class="form-outline">
                                                <input type="number" id="stock" name="stock" class="form-control form-control-lg" required min="1" max="100">
                                            </div>
                                        </div>
                                    </div>
                                </div>
    
                                <div class="col-lg-6">
                                    <div class="p-5">
                                        <div class="mb-4 pb-2">
                                            <label class="form-label fw-bold" for="rating">Rating(1-5)</label>
                                            <div class="form-outline">
                                                <input type="number" id="rating" name="rating" class="form-control form-control-lg" required min="1" max="5">
                                            </div>
                                        </div>
    
                                        <div class="mb-4 pb-2">
                                            <label class="form-label fw-bold" for="description">Description</label>
                                            <div class="form-outline">
                                                <textarea style="height: 100px; font-size: 16px; vertical-align: middle;" id="description" name="description" class="form-control form-control-lg" required></textarea>
                                            </div>
                                        </div>
    
                                        <div class="mb-4 pb-2">
                                            <label class="form-label fw-bold" for="productPicture">Product Picture:</label>
                                            <input type="file" name="productPicture" id="productPicture" class="form-control" accept="image/*" required>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="d-block mx-auto btn btn-success mt-4" style="width: 400px; background: greenyellow; font-weight: bolder; color: black;" data-mdb-ripple-color="dark">Add</button>
                </div>
                <div class="overlay" id="overlay">
                    <div class="dialog-box">
                        <p id='message'></p>
                        <button class="close-btn" onclick="closeDialog_donot_reload()">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    </main>







