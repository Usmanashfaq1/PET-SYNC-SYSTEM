     if (password != repeat_password) {
      document.getElementById('message').innerText = 'Both passwords and confirm password must be same!';
      showDialog();
      return;
    }
    if(code!=code123)
      {
        document.getElementById('message').innerText = 'Incorrect code!!!';
      showDialog();
        return;
      }
    var data = { username: username, email: email, password: password, confirm_password: repeat_password };
