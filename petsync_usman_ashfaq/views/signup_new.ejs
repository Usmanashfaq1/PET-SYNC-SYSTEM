<script>
  var code123 = null;
  function register() {


    var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    var username = $("#username").val();
    var email = $("#email").val();
    var password = $("#password").val();
    var repeat_password = $("#repeat_password").val();
