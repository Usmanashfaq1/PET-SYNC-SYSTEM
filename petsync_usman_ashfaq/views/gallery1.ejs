.menu-slide {
    padding: 20px;
}

.menu-slide a {
    display: block;
    padding: 10px 0;
    color: #333;
    text-decoration: none;
}

.menu-slide a:hover {
    background-color: #f0f0f0;
}

/* Menu icon styles */
#menu-toggle {
    cursor: pointer;
}

/* Hide scrollbar */
body {
    overflow-y: auto;
}

/* Show scrollbar when sidebar is open */
body.sidebar-open {
    overflow-y: hidden;
}


/* bar */
.link-items-container {
    display: flex;
    flex-direction: row;
    justify-content: space-between; /* Adjust spacing between items */
